# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"
# Business timezone used to decide which calendar day a work belongs to
BUSINESS_TIMEZONE="Asia/Kolkata"
# Local file storage directory (development). Production: S3-compatible storage.
UPLOAD_DIR="./uploads"
# 32-byte base64 key used to encrypt notification provider credentials.
# Generate: node -e 'console.log(require("crypto").randomBytes(32).toString("base64"))'
# Keep it secret and stable — changing it makes stored provider credentials unreadable.
SECRETS_ENCRYPTION_KEY=""
# Public HTTPS URL of the app (used for delivery-status webhooks)
APP_URL="https://crm.example.com"
